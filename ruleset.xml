<?xml version="1.0"?>
<ruleset name="Carmazzi Theme — WordPress Standards">
  <description>
    Apply WordPress Coding Standards, with a focus on escaping, sanitization, and consistency.
  </description>

  <!-- Scan project root -->
  <file>./</file>

  <!-- Ignore non-PHP/vendor/build assets -->
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <exclude-pattern>*/assets/images/*</exclude-pattern>
  <exclude-pattern>*/assets/js/*</exclude-pattern>
  <exclude-pattern>*/doc/*</exclude-pattern>
  <exclude-pattern>*/.git/*</exclude-pattern>
  <exclude-pattern>*/screenshot.png</exclude-pattern>

  <!-- WordPress Coding Standards -->
  <rule ref="WordPress-Core"/>
  <rule ref="WordPress-Docs"/>
  <rule ref="WordPress-Extra"/>

  <!-- Security and best practices -->
  <rule ref="WordPress.Security.EscapeOutput"/>
  <rule ref="WordPress.Security.NonceVerification"/>

  <!-- Helpful reporting options -->
  <arg name="colors"/>
  <arg value="sp"/>

  <!-- Target PHP 8+ -->
  <config name="testVersion" value="8.0-"/>

  <!-- You can suppress specific sniffs here if needed
  <exclude name="Generic.Files.LineLength"/>
  -->
</ruleset>
